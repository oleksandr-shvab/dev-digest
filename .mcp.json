{
  "mcpServers": {
    "devdigest": {
      "type": "stdio",
      "command": "mcp-server/node_modules/.bin/tsx",
      "args": ["mcp-server/src/main.ts"],
      "env": {
        "DEVDIGEST_API_URL": "${DEVDIGEST_API_URL:-http://localhost:3001}",
        "DEVDIGEST_RUN_WAIT_MS": "${DEVDIGEST_RUN_WAIT_MS:-120000}"
      }
    }
  }
}
