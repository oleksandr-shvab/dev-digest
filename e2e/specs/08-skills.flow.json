{
  "name": "Skills: create, edit + version, restore, link to an agent, import a zip",
  "description": "Deterministic (no model call) walk through the Skills feature. Creates skill 'e2e-skill' on /skills/new; edits its body with a 'What changed?' message so Versions shows v2; restores v1 so v3 is current; links it to the seeded Test Quality Reviewer and toggles + keyboard-reorders it on the agent's Skills tab; imports docs/agent-prompts/fixtures/flaky-tests.zip through the preview (asserting scripts/ is listed as ignored); finally checks the saved skills appear in the list. Assumes a freshly-seeded DB (hermetic runner / e2e-web.yml): 'e2e-skill' and 'flaky-tests' must not exist yet, and Test Quality Reviewer has its 3 seeded skills linked. The upload path is relative to the e2e/ directory (the runner's cwd).",
  "steps": [
    { "cmd": ["open", "{BASE}/skills/new"], "label": "open the empty create form" },
    { "cmd": ["wait", "--url", "/skills/new"], "label": "new-skill route reached" },
    { "cmd": ["wait", "--text", "New skill"], "label": "create form renders" },
    { "cmd": ["find", "label", "Name", "fill", "e2e-skill"], "label": "fill the name" },
    { "cmd": ["find", "label", "Description", "fill", "Flag tests that never assert"], "label": "fill the description" },
    { "cmd": ["find", "label", "Skill body", "fill", "# Rule v1\nCheck that every test asserts something."], "label": "fill the body" },
    { "cmd": ["find", "role", "button", "click", "--name", "Save skill"], "label": "save the new skill" },
    { "cmd": ["wait", "--text", "Versions"], "label": "redirected to the skill detail (tabs visible)" },

    { "cmd": ["find", "label", "Skill body", "fill", "# Rule v2\nCheck that every test asserts something specific."], "label": "edit the body" },
    { "cmd": ["find", "label", "What changed?", "fill", "tighten wording"], "label": "type the version message" },
    { "cmd": ["find", "role", "button", "click", "--name", "Save skill"], "label": "save the edit" },
    { "cmd": ["wait", "--text", "Saved as v2"], "label": "toast confirms version 2" },
    { "cmd": ["find", "role", "button", "click", "--name", "Versions"], "label": "open the Versions tab" },
    { "cmd": ["wait", "--text", "tighten wording"], "label": "v2 row shows its message" },
    { "cmd": ["wait", "--text", "Initial version"], "label": "v1 row is kept" },

    { "cmd": ["find", "role", "button", "click", "--name", "Restore v1"], "label": "restore v1" },
    { "cmd": ["find", "role", "button", "click", "--name", "Confirm restore"], "label": "confirm the restore" },
    { "cmd": ["wait", "--text", "Restored v1 as v3"], "label": "restore creates v3" },
    { "cmd": ["wait", "--text", "Restored from v1"], "label": "v3 row carries the restore message" },

    { "cmd": ["open", "{BASE}/agents"], "label": "open the agents list" },
    { "cmd": ["find", "text", "Test Quality Reviewer", "click"], "label": "open Test Quality Reviewer" },
    { "cmd": ["wait", "--url", "/agents/"], "label": "agent editor route reached" },
    { "cmd": ["find", "role", "button", "click", "--name", "Skills"], "label": "switch to the agent's Skills tab" },
    { "cmd": ["wait", "--url", "tab=skills"], "label": "skills tab is in the URL" },
    { "cmd": ["wait", "--text", "Order matters"], "label": "skills tab renders" },
    { "cmd": ["wait", "--text", "3 of 3 enabled"], "label": "the 3 seeded skills are linked and enabled" },
    { "cmd": ["find", "text", "+ Link skill", "click"], "label": "open the link picker" },
    { "cmd": ["find", "role", "button", "click", "--name", "e2e-skill"], "label": "link e2e-skill" },
    { "cmd": ["wait", "--text", "4 of 4 enabled"], "label": "linked skill is appended and enabled (saved immediately)" },
    { "cmd": ["find", "role", "checkbox", "click", "--name", "Enable e2e-skill for this agent"], "label": "toggle the skill off for this agent" },
    { "cmd": ["wait", "--text", "3 of 4 enabled"], "label": "badge follows the toggle" },
    { "cmd": ["find", "role", "button", "focus", "--name", "Reorder e2e-skill"], "label": "focus the drag handle" },
    { "cmd": ["press", "Space"], "label": "pick the row up (keyboard)" },
    { "cmd": ["press", "ArrowUp"], "label": "move it up one place" },
    { "cmd": ["press", "Space"], "label": "drop it" },
    { "cmd": ["wait", "--load", "networkidle"], "label": "the immediate PUT settles" },
    { "cmd": ["open", "{BASE}/agents"], "label": "leave and come back to check persistence" },
    { "cmd": ["find", "text", "Test Quality Reviewer", "click"], "label": "reopen Test Quality Reviewer" },
    { "cmd": ["find", "role", "button", "click", "--name", "Skills"], "label": "open the Skills tab again" },
    { "cmd": ["wait", "--text", "3 of 4 enabled"], "label": "toggle and link were persisted" },

    { "cmd": ["open", "{BASE}/skills"], "label": "open the Skills page" },
    { "cmd": ["wait", "--text", "Select a skill"], "label": "nothing selected yet" },
    { "cmd": ["find", "role", "button", "click", "--name", "Add Skill"], "label": "open the Add Skill menu" },
    { "cmd": ["find", "role", "button", "click", "--name", "Import from file…"], "label": "choose Import from file…" },
    { "cmd": ["wait", "--text", "Drop a .md or .zip file here"], "label": "import modal shows the file picker" },
    { "cmd": ["upload", "input[type=file]", "../docs/agent-prompts/fixtures/flaky-tests.zip"], "label": "pick flaky-tests.zip" },
    { "cmd": ["wait", "--text", "Ignored files"], "label": "preview lists ignored files" },
    { "cmd": ["wait", "--text", "scripts/"], "label": "the scripts/ entry is reported as ignored" },
    { "cmd": ["wait", "--text", "not imported"], "label": "with its reason" },
    { "cmd": ["wait", "--text", "written by someone else"], "label": "trust banner is shown" },
    { "cmd": ["find", "role", "button", "click", "--name", "Save skill"], "label": "save the imported skill" },
    { "cmd": ["wait", "--url", "tab=preview"], "label": "new skill is selected on the Preview tab" },

    { "cmd": ["open", "{BASE}/skills"], "label": "reload the Skills list" },
    { "cmd": ["wait", "--text", "e2e-skill"], "label": "the created skill is listed" },
    { "cmd": ["wait", "--text", "flaky-tests"], "label": "the imported skill is listed" }
  ]
}
